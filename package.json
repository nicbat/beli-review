{
  "name": "beli-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "python3 run.py",
    "test": "npm run test:backend && npm run test:frontend",
    "format": "prettier --write app/frontend/src app/frontend/index.html vite.config.mjs",
    "format:check": "prettier --check app/frontend/src app/frontend/index.html vite.config.mjs",
    "test:backend": "python3 -m unittest discover -s app/tests -v",
    "test:frontend": "node --experimental-strip-types --test app/frontend/tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "type": "module"
}
